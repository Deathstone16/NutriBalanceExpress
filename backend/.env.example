# Valores de desarrollo local. Copiar a .env; nunca subir .env a Git.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Desarrollo local HTTP: none / false / lax.
# Con cloudflared en esta misma máquina: loopback / true / lax.
# Si el frontend está en OTRO sitio: usar none en SAME_SITE (requiere HTTPS).
TRUST_PROXY=none
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
CLINIC_TIME_ZONE=America/Argentina/Buenos_Aires

# Solo PostgreSQL local. Si cambia la contraseña, actualizar también ambas URLs.
POSTGRES_USER=nutri
POSTGRES_PASSWORD=nutri_local_only
POSTGRES_DB=nutri_dev
DATABASE_URL=postgresql://nutri:nutri_local_only@localhost:5433/nutri_dev
# La BD nutri_test se crea por separado; compose solo crea nutri_dev.
TEST_DATABASE_URL=postgresql://nutri:nutri_local_only@localhost:5433/nutri_test

# Completar con un secreto aleatorio; no usar un valor fijo del repositorio.
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Datos ficticios para seed; la contraseña se completa localmente y se hashea.
SEED_PROFESSIONAL_EMAIL=nutri@example.test
SEED_PROFESSIONAL_PASSWORD=
